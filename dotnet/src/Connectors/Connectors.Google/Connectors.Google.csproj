<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- THIS PROPERTY GROUP MUST COME FIRST -->
    <AssemblyName>Microsoft.SemanticKernel.Connectors.Google</AssemblyName>
    <RootNamespace>$(AssemblyName)</RootNamespace>
    <TargetFrameworks>net10.0;net8.0;netstandard2.0</TargetFrameworks>
    <VersionSuffix>alpha.1</VersionSuffix>
    <NoWarn>$(NoWarn);SKEXP0001</NoWarn>
  </PropertyGroup>

  <!-- IMPORT NUGET PACKAGE SHARED PROPERTIES -->
  <Import Project="$(RepoRoot)/dotnet/nuget/nuget-package.props" />
  <Import Project="$(RepoRoot)/dotnet/src/InternalUtilities/src/InternalUtilities.props" />

  <PropertyGroup>
    <!-- NuGet Package Settings -->
    <PackageId>Community.SemanticKernel.Connectors.Google</PackageId>
    <Title>Community Semantic Kernel - Google Connectors (Unofficial)</Title>
    <Authors>Microsoft; lil-kita</Authors>
    <Description>Unofficial fork of the Semantic Kernel Google connectors, based on upstream 1.81.0-alpha. Fixes Gemini function-response messages to use the supported user role. Contains GoogleAI/VertexAI generation and embedding services.</Description>
    <PackageProjectUrl>https://github.com/lil-kita/semantic-kernel-google-connector</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lil-kita/semantic-kernel-google-connector</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Serialize Gemini tool results with the user role while preserving function-response payloads and internal tool roles.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="$(RepoRoot)/dotnet/nuget/NUGET.md" />
    <None Include="README.md" Pack="true" PackagePath="." />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' != 'Publish'">
    <ProjectReference Include="..\..\SemanticKernel.Abstractions\SemanticKernel.Abstractions.csproj" />
    <ProjectReference Include="..\..\SemanticKernel.Core\SemanticKernel.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Publish'">
    <PackageVersion Update="Microsoft.SemanticKernel.Abstractions" Version="1.81.0" />
    <PackageVersion Update="Microsoft.SemanticKernel.Core" Version="1.81.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Abstractions" />
    <PackageReference Include="Microsoft.SemanticKernel.Core" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' or '$(TargetFramework)' == 'net9.0' or '$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Google.GenAI" />
    <PackageReference Include="Google.Apis.Auth" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SemanticKernel.Connectors.GoogleVertexAI.UnitTests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
